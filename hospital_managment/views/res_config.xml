<odoo>
    <data>
        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res_configuration_settings_view_form_hospital</field>
<!--            <field name="name">res.config.settings.view.form.inherit.hr.hospital</field>-->
            <field name="model">res.config.settings</field>
            <field name="priority" eval="90"/>
            <field name="inherit_id" ref="base.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[hasclass('settings')]" position="inside">
                    <div class="app_settings_block" data-string="hospital" id="hospital" string="hospital" data-key="hospital_managment">
                        <h2>hospital Management</h2>
                        <div class="row mt16 o_settings_container" id="end_contract_setting">
                            <div class="col-12 col-lg-6 o_setting_box">
                                <div class="o_setting_left_pane"/>
                                <div class="o_setting_right_pane">
                                    <span class="o_form_label">End Date Contract Alert</span>
                                    <div class="text-muted content-group mt16">
                                        <span>cancel days</span>
                                        <field name="cancel_days" class="text-center oe_inline" />
                                        <span> days before the end date</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>



        <record id="hospital_configuration_actions" model="ir.actions.act_window">
            <field name="name">Settings</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">res.config.settings</field>
            <field name="view_mode">form</field>
            <field name="target">inline</field>
            <field name="context">{'module' : 'hospital_managment', 'bin_size': False}</field>
        </record>

        <menuitem id="configuration_menu" parent="hospital_menu_root" name="configuration">
            <menuitem id="hospital_configuration_menu" name="hospital" action="hospital_configuration_actions"/>
        </menuitem>
    </data>
</odoo>