<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree View -->
    <record id="view_odoo_playground_tree" model="ir.ui.view">
        <field name="name">odoo.playground.tree</field>
        <field name="model">odoo.playground</field>
        <field name="arch" type="xml">
            <tree>
                <field name="model_id"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_odoo_playground_form" model="ir.ui.view">
        <field name="name">odoo.playground.form</field>
        <field name="model">odoo.playground</field>
        <field name="arch" type="xml">
            <form string="Odoo Playground">
                <header>

                    <button name="action_excution"
                            string="Execute"
                            type="object"
                            class="btn-primary"/>

                    <button name="action_clear"
                            string="Clear"
                            type="object"
                            class="btn-secondary"/>

                </header>

                <sheet>

                    <group>
                        <field name="model_id"/>
                    </group>

                    <notebook>

                        <page string="Python Code">

                            <field name="code"
                                   nolabel="1"
                                   widget="ace"
                                   options="{'mode':'python'}"
                                   placeholder="Write Python code here..."/>

                        </page>

                        <page string="Result">

                            <field name="result_code"
                                   nolabel="1"
                                   readonly="1"
                                   widget="text"/>

                        </page>

                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_odoo_playground" model="ir.actions.act_window">
        <field name="name">Odoo Playground</field>
        <field name="res_model">odoo.playground</field>
        <field name="view_mode">tree,form</field>
    </record>


    <menuitem id="menu_odoo_playground"
              name="Playground"
              parent="hospital_menu_root"
              action="action_odoo_playground"/>

</odoo>