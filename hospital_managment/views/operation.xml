<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Tree View -->
    <record id="view_operation_tree" model="ir.ui.view">
        <field name="name">operation.operation.tree</field>
        <field name="model">operation.operation</field>
        <field name="arch" type="xml">
            <tree string="Operations">
                <field name="doctor_id"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_operation_form" model="ir.ui.view">
        <field name="name">operation.operation.form</field>
        <field name="model">operation.operation</field>
        <field name="arch" type="xml">
            <form string="Operation">
                <sheet>
                    <group>
                        <field name="doctor_id"/>
                        <field name="ref"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_operation" model="ir.actions.act_window">
        <field name="name">Operations</field>
        <field name="res_model">operation.operation</field>
        <field name="view_mode">tree,form</field>
    </record>



    <menuitem id="menu_operation"
              name="Operations"
              parent="hospital_menu_root"
              action="action_operation"/>

</odoo>